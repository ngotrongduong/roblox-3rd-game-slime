local Breeding = require("../../src/shared/Breeding")
local Config = require("../../src/shared/Config")
local FarmKit = require("../lib/FarmKit")
local FarmState = require("../../src/shared/FarmState")
local Hatching = require("../../src/shared/Hatching")
local Stats = require("../../src/shared/Stats")
local Rng = require("../../src/shared/Rng")

local NOW = 1000000
return function(T)
	T.test("pair places accept only different, available adults", function()
		local farm = FarmKit.farm(NOW)
		T.eq(#farm.breeding.pairs, 2)
		T.eq(select(2, Breeding.setPair(farm, 1, "slime-1", "slime-1", NOW)), "SAME_PARENT")
		T.ok(Breeding.setPair(farm, 1, "slime-1", "slime-2", NOW))
		T.eq(select(2, Breeding.setPair(farm, 2, "slime-1", "slime-3", NOW)), "IN_PAIR")
		T.ok(Breeding.setPair(farm, 2, nil, nil, NOW))
		local baby = FarmKit.slime("baby", { createdAt = NOW })
		table.insert(farm.slimes, baby)
		T.eq(select(2, Breeding.setPair(farm, 2, "baby", "slime-3", NOW)), "PARENT_TOO_YOUNG")
		T.ok(Breeding.pairReady(farm, 1, NOW).ok)
		farm.slimes[1].needs.fullness = 59
		T.ok(not Breeding.pairReady(farm, 1, NOW).ok)
		farm.slimes[1].needs.fullness = 100
		farm.slimes[2].ghostUntil = NOW + 100
		T.ok(not Breeding.pairReady(farm, 1, NOW).ok)
	end)
	T.test("a nest egg hatches at half speed; an incubator keeps its progress at full speed", function()
		local farm = FarmKit.farm(NOW)
		T.ok(Breeding.setPair(farm, 1, "slime-1", "slime-2", NOW))
		T.ok(Breeding.startCourtship(farm, 1, NOW).ok)
		T.eq(farm.breeding.pairs[1].courtingUntil, NOW + 60)
		T.eq(Breeding.layEgg(farm, 1, NOW + 59, Rng.new(1), FarmKit.ids()).reason, "NOT_COURTED")
		local result = Breeding.layEgg(farm, 1, NOW + 60, Rng.new(1), FarmKit.ids())
		T.ok(result.ok)
		local egg = result.egg
		assert(egg)
		T.eq(egg.place, "nest")
		local full = Breeding.incubationSeconds(Stats.level(egg.embryo.stats), 1)
		local factor = Config.Breeding.NestSlowFactor
		T.eq(egg.hatchAt, NOW + 60 + full * factor, "the nest clock starts at laying, slower")
		T.eq(FarmState.eggStatus(egg, NOW + 61), "nest")
		T.eq(result.farm.slimes[1].needs.energy, 70)
		-- a quarter of the nest time passed, then it moves: the rest runs at the incubator's rate
		local moveAt = NOW + 60 + full * factor / 4
		T.ok(Breeding.placeInIncubator(result.farm, egg.id, moveAt))
		T.eq(egg.place, "incubator", "the returned egg is the farm egg")
		local finish = moveAt + full * 3 / 4
		T.near(egg.hatchAt, finish, 1e-6)
		T.eq(Hatching.hatch(result.farm, egg.id, finish - 1).reason, "NOT_READY")
		T.ok(Hatching.hatch(result.farm, egg.id, finish + 1e-6).ok)
		T.eq(Breeding.incubationSeconds(4, 1), 60)
		T.eq(Breeding.incubationSeconds(9, 1), 65)
		T.eq(Breeding.incubationSeconds(4, 50), math.round(60 * 0.98 ^ 49))
	end)
	T.test("an egg never carried hatches in its nest after twice the time", function()
		local farm = FarmKit.farm(NOW)
		local made = Breeding.createEgg(farm, "slime-1", "slime-2", NOW, Rng.new(1), FarmKit.ids())
		T.ok(made.ok)
		local egg = made.farm.eggs[1]
		local nestTime = Breeding.nestSeconds(egg, 1)
		T.eq(Hatching.nextReadyEgg(made.farm, NOW + nestTime - 1), nil)
		T.eq(Hatching.nextReadyEgg(made.farm, NOW + nestTime), egg)
		T.ok(Hatching.hatch(made.farm, egg.id, NOW + nestTime).ok)
	end)
	T.test("occupied nests and population both block new eggs", function()
		local farm = FarmKit.farm(NOW)
		local e1 = Breeding.createEgg(farm, "slime-1", "slime-2", NOW, Rng.new(1), FarmKit.ids())
		T.ok(e1.ok)
		local e2 = Breeding.createEgg(e1.farm, "slime-3", "slime-4", NOW, Rng.new(2), FarmKit.ids())
		T.ok(e2.ok)
		T.eq(Breeding.check(e2.farm, "slime-1", "slime-3", NOW + 100).reason, "EGG_CAP_REACHED")
		local big = FarmKit.farm(NOW, FarmKit.many(12))
		T.eq(Breeding.check(big, "s1", "s2", NOW).reason, "SLIME_CAP_REACHED")
		T.eq(FarmState.populationLimit(big.areas), 12)
	end)
end
