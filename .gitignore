*.rbxl
# Copies of the owner's art picked for ChatGPT prompts (the originals are in reference/).
art/chatgpt-refs/
# Work folders of skill meshy-multiview (each subject's source, ChatGPT's raw views, the lined-up views; made again
# from the source, too big for the repo). The ledger is docs/turnaround.md.
art/turnaround/
# Pictures waiting for the owner to upload them through Studio.
art/upload_now/
# Pictures as ChatGPT made them (the chosen ones are copied to art/concept/).
art/inbox/
# Work places opened in Studio (the map is built in them by tools/map scripts).
assets/raw/
# Blender comparison renders of every round (tools/blender scripts make them again; the final sheets
# are copied next to the model).
art/models/**/review/
# Textures FBX importers unpack next to a model (the originals sit beside the .fbx).
*.fbm/
# Blender's backup of the file before its last save.
*.blend1
__pycache__/
*.rbxlx
*.rbxl.lock
*.rbxlx.lock
sourcemap.json
roblox.yml
# Roblox type definitions for tools\types.ps1 (from JohnnyMorganz/luau-lsp).
tools/types/
# The original web game, downloaded for reference only (its code and art stay out of the repo until
# a piece is deliberately taken into assets/).
reference/goo-lineage-web/
# Other authors' packs: usable inside the game, but this repo is public and they must not be passed on as files
# (tools/map/prepare_quaternius.py makes the .glb files again from the author's own download).
art/models/quaternius/
art/models/GooLineage_Free_Asset_Library_Curated/
# Whole free packs kept for later (Kenney, Quaternius; CC0): too big for the repo, taken into the game piece by piece.
art/library/
*.zip
