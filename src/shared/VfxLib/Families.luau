local byKey = {}
for _, family in Families.List do
	for _, key in family.keys do
		byKey[key] = family.name
	end
end

-- The family of a texture key, nil when it has none.
function Families.of(key)
	return byKey[key]
end

-- The keys of a family, nil when there is no such family.
function Families.keys(name)
	for _, family in Families.List do
		if family.name == name then
			return family.keys
		end
	end
	return nil
end

return Families
