--!strict
-- Every emotion a slime can show, as data: which face parts, how the eyes and mouth behave, the little emote above the
-- head, and the body motion that goes with it (SlimeMotion). Pure data, so a test checks that every picture and
-- motion it names exists. SlimeFace draws it; a future brain only has to say `setEmotion("happy")`.
--
-- Sprites are names in FaceArt: the owner's own cut pixels ("normal_eyeL", "sad_mouth", ...) and the few pieces drawn
-- in the same style ("lid2_L", "swirl_R", "brow_L", "blush", "sweat", "tear_drop", "icon_*"). Positions come from the
-- sprites themselves (where the owner's art puts them); `dx`/`dy` below are extra, in body heights.

local Expressions = {}

export type Brow = {
	-- degrees; positive = the inner end up (worried), negative = the inner end down (stern)
	tilt: number,
	dy: number?, -- extra height above the eye, body heights
}

export type Expression = {
	id: string,
	-- eyes
	eyeL: string,
	eyeR: string,
	eyeTurnedL: boolean?, -- upside down: a closed arc becomes a happy ^
	eyeTurnedR: boolean?,
	-- round eyes look at things and blink; closed eyes, > < and swirls do not
	alive: boolean,
	-- 0..1: how far the eyes follow a target; gazeBias: where they look with no target (-1..1)
	gaze: number,
	gazeBiasX: number?,
	gazeBiasY: number?,
	gazeJitter: boolean?, -- darting eyes (scared)
	gazeWander: boolean?, -- eyes that drift about by themselves (bored)
	-- a lid on round eyes: step 0 (open) .. 4 (nearly shut), swinging by `amp` at `hz`
	lid: number?,
	lidAmp: number?,
	lidHz: number?,
	spin: number?, -- swirl eyes turn this many degrees a second
	browL: Brow?,
	browR: Brow?,
	-- mouth
	mouth: string,
	mouthScale: number?,
	mouthAlt: string?, -- what a chew opens into
	mouthAnim: string?, -- "chew" | "talk" | "laugh" | "yawn" | "quiver"
	-- extras on the face
	blush: boolean?,
	sweat: boolean?,
	tears: boolean?,
	-- the emote above the head
	icon: string?,
	-- the body motion (SlimeMotion) and how often a blink comes: 0 never, 1 normal, 2 slow
	motion: string,
	blink: number,
}

